# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Supabase / PostgreSQL)
DATABASE_URL=postgresql://postgres.xxxx:your_supabase_password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Binance API Credentials
BINANCE_BASE_URL=https://api.binance.com
BINANCE_API_KEY=tu_binance_api_key_aqui
BINANCE_SECRET_KEY=tu_binance_secret_key_aqui

# Mercado Pago Brasil Credentials (PIX BR)
MP_BR_ACCESS_TOKEN=tu_mercadopago_br_access_token_aqui
MP_WEBHOOK_SECRET=tu_mercadopago_br_webhook_secret_aqui

# Mercado Pago Argentina Credentials (CBU/CVU ARS)
MP_AR_ACCESS_TOKEN=tu_mercadopago_ar_access_token_aqui
MP_AR_WEBHOOK_SECRET=tu_mercadopago_ar_webhook_secret_aqui

# Security & Webhook Settings
WEBHOOK_SECRET=tu_webhook_secret_de_sistema_aqui

# Margin & Commission Settings (0.02 = 2%)
FX_MARGIN_PERCENTAGE=0.02

# Emergency Notification System (Telegram Bot - Opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
